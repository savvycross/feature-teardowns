---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import { site } from '../site';

const teardowns = (await getCollection('teardowns')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
const number = (i: number) => String(teardowns.length - i).padStart(2, '0');
---

<Base>
  <section class="wrap hero">
    <p class="label label-accent">Made with AI coding agents + REA</p>
    <h1>See how great features work. <em>Then build your own.</em></h1>
    <p class="hero-lede">
      Plain-English teardowns of popular app features, researched with AI coding agents and REA (Reverse Engineer
      Anything).
      Each one ends with a prompt you can paste into an AI coding agent.
    </p>
  </section>

  <section class="wrap" id="teardowns">
    <div class="section-head label">
      <h2 class="label">Teardowns</h2>
      <span class="muted">{teardowns.length} published</span>
    </div>

    <ul class="card-grid">
      {teardowns.map((entry, i) => (
        <li>
          <article class="card">
            <p class="label label-accent">No. {number(i)}</p>
            <h3><a href={`/teardowns/${entry.id}`}>{entry.data.title}</a></h3>
            <p>{entry.data.summary}</p>
            <div class="card-meta label">
              <span>{entry.data.app}</span>
              <span class="muted">{entry.data.difficulty} / {entry.data.readTime} min</span>
            </div>
          </article>
        </li>
      ))}
    </ul>
  </section>

  {site.signupAction && (
    <div class="wrap">
      <section class="signup" aria-labelledby="signup-title">
        <div>
          <p class="label">Newsletter</p>
          <h2 id="signup-title">Get each new teardown by email.</h2>
        </div>
        <form class="signup-form" action={site.signupAction} method="post">
          <label class="visually-hidden" for="signup-email">Email address</label>
          <input id="signup-email" type="email" name="email" placeholder="you@example.com" autocomplete="email" required />
          <button class="button" type="submit">Sign up</button>
        </form>
      </section>
    </div>
  )}
</Base>
